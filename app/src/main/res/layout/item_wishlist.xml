<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    android:id="@+id/mcvItemWishlist"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clItemWishlist"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp">

        <ImageView
            android:id="@+id/ivGameCoverWishlist"
            android:layout_width="72dp"
            android:layout_height="108dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/cover"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvGameTitleWishlist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/green"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintEnd_toStartOf="@+id/btnDeleteWishlist"
            app:layout_constraintStart_toEndOf="@+id/ivGameCoverWishlist"
            app:layout_constraintTop_toTopOf="@+id/ivGameCoverWishlist"
            tools:text="Játék neve"/>

        <TextView
            android:id="@+id/tvGameYearWishlist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/black"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="@+id/tvGameTitleWishlist"
            app:layout_constraintStart_toStartOf="@+id/tvGameTitleWishlist"
            app:layout_constraintTop_toBottomOf="@+id/tvGameTitleWishlist"
            tools:text="Kiadási év"/>

        <TextView
            android:id="@+id/tvGamePublisherWishlist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="@+id/tvGameTitleWishlist"
            app:layout_constraintStart_toStartOf="@+id/tvGameTitleWishlist"
            app:layout_constraintTop_toBottomOf="@+id/tvGameYearWishlist"
            tools:text="Kiadó"/>

        <ImageButton
            android:id="@+id/btnDeleteWishlist"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/delete_game"
            android:src="@drawable/ic_delete"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#D32F2F" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>